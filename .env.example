# Copy to .env (git-ignored) and fill in: cp .env.example .env && chmod 600 .env
# Environment variables override values in .env.

# LLM provider keys. Names follow inspect-robots-agent; fill only what you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional: run the LIBERO worker under a different interpreter
# (default: the one running inspect-robots).
# LIBERO_PYTHON=
